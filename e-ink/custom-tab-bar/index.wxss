.custom-tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f5f5f5 100%);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  transition: all 0.3s ease;
}

.tab-item .icon-wrapper {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  margin-bottom: 6rpx;
  transition: all 0.3s ease;
}

.tab-item .text {
  font-size: 22rpx;
  color: #666666;
  transition: all 0.3s ease;
  font-weight: 400;
}

.tab-item.active .icon-wrapper {
  background: linear-gradient(135deg, #A5D8EF 0%, #8BC4E8 100%);
  transform: scale(1.1);
  box-shadow: 0 8rpx 20rpx rgba(165, 216, 239, 0.35);
}

.tab-item.active .icon-wrapper t-icon {
  color: #ffffff !important;
}

.tab-item.active .icon-wrapper .t-icon {
  color: #ffffff !important;
}

.tab-item.active .text {
  color: #FF5F15;
  font-weight: 600;
}