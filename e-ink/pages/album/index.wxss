.album-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.header {
  padding: 60rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  display: block;
}

.count {
  font-size: 28rpx;
  opacity: 0.8;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  padding: 8rpx;
}

.photo-item {
  aspect-ratio: 1;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.photo-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #e8e8e8 0%, #f5f5f5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ccc;
}

.photo-num {
  font-size: 32rpx;
  color: #999;
  font-weight: bold;
}

.add-btn {
  position: fixed;
  right: 32rpx;
  bottom: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: #667eea;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
}

.add-icon {
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
}