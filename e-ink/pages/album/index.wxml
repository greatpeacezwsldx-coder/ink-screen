<view class="album-page">
  <view class="header">
    <text class="title">My Album</text>
    <text class="count">9 photos</text>
  </view>
  
  <view class="photo-grid">
    <view class="photo-item" wx:for="{{9}}" wx:key="index">
      <view class="photo-placeholder">
        <text class="photo-num">{{index + 1}}</text>
      </view>
    </view>
  </view>
  
  <view class="add-btn" bindtap="choosePhoto">
    <text class="add-icon">+</text>
  </view>
</view>