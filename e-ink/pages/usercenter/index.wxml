<t-user-center-card
  userInfo="{{userInfo}}"
  isPhoneHide="{{true}}"
  name-class="custom-name-class"
  phone-class="custom-phone-class"
  avatar-class="customer-avatar-class"
  currAuthStep="{{currAuthStep}}"
  bind:gotoUserEditPage="gotoUserEditPage"
/>
<view class="content-wrapper">
  <view class="menu-group">
    <view wx:for="{{menuData}}" wx:key="index" class="menu-item" bind:tap="onClickCell" data-type="{{item.type}}">
      <view class="menu-icon">
        <t-icon name="{{item.icon}}" size="48rpx" />
      </view>
      <view class="menu-title">{{item.title}}</view>
      <t-icon name="chevron-right" size="40rpx" color="#CCCCCC" />
    </view>
  </view>
</view>
<view class="footer__version" wx:if="{{versionNo !== ''}}">当前版本 {{versionNo}}</view>
<t-toast id="t-toast" />